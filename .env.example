# ================= APP =================
NODE_ENV=development
APP_NAME=cryptocroc-runner
STRATEGY_MODE=runner

# ================= ADMIN =================
# Gebruikt door /api/filter-config
ADMIN_TOKEN=change_me

# ================= DISCORD =================
# A-grade / elite runner alerts
DISCORD_WEBHOOK_A=

# B-grade runner alerts
DISCORD_WEBHOOK_B=

# Legacy fallback, alleen gebruiken als je oude notifier dit nog verwacht
DISCORD_WEBHOOK_URL=

# ================= STORAGE / DURABLE STATE =================
# Vercel KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Of Upstash Redis direct
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ================= POSTGRES / NEON OPTIONAL =================
# db.js checkt deze in volgorde.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
NEON_DATABASE_URL=

# ================= RUNNER / CRON OPTIONAL =================
# Alleen gebruiken als je api-routes dit checken
CRON_SECRET=

# ================= VERCEL =================
# Wordt automatisch gezet door Vercel
VERCEL=
VERCEL_ENV=