{
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs"
    }
  },
  "crons": [
    { "path": "/api/cron?mode=bull", "schedule": "*/10 * * * *" },
    { "path": "/api/cron?mode=bear", "schedule": "*/10 * * * *" },

    { "path": "/api/moon/cron?mode=bull", "schedule": "*/5 * * * *" },
    { "path": "/api/moon/cron?mode=bear", "schedule": "*/5 * * * *" },

    { "path": "/api/track", "schedule": "*/10 * * * *" }
  ]
}